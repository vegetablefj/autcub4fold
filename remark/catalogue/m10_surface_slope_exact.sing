// One generic hyperplane section of the corrected M10 pencil's singular scheme over Q.
ring R=0,(x1,x2,x3,x4,x5,x6,t),dp;
poly f=2*(x1^3+x2^3+x3^3+x4^3+x5^3+x6^3)
  +3*(x1^2*x2+x1*x2^2+x3^2*x4+x3*x4^2+x5^2*x6+x5*x6^2)
  +2*(x2*x3*x5+x1*x4*x5+x1*x3*x6+x2*x4*x6)
  +4*(x1*x3*x5+x2*x4*x5+x2*x3*x6+x1*x4*x6);
poly g=3*(x1*x2*x3+x1*x2*x4+x1*x2*x5+x1*x2*x6+x1*x3*x4+x1*x3*x5+x1*x5*x6
  +x2*x3*x4+x2*x5*x6+x3*x5*x6+x3*x4*x6+x3*x4*x5+x4*x5*x6)
  -4*(x1*x4*x5+x1*x3*x6+x2*x3*x5+x2*x4*x6)
  -5*(x1*x4*x6+x2*x3*x6+x2*x4*x5)-8*x1*x3*x5;
ideal Jf=diff(f,x1),diff(f,x2),diff(f,x3),diff(f,x4),diff(f,x5),diff(f,x6),t;
Jf=std(Jf);
print("affine Jacobian cone dimension at f (must be zero):");
dim(Jf);
if (dim(Jf) != 0) {
  ERROR("The cubic f has a positive-dimensional affine Jacobian scheme.");
}
poly F=f-t*g;
ideal J=diff(F,x1),diff(F,x2),diff(F,x3),diff(F,x4),diff(F,x5),diff(F,x6),
  x1+2*x2+3*x3+4*x4+5*x5+6*x6;
ideal C=J;
ideal B=J;
ideal E=J;
print("characteristic-zero one-hyperplane section: all six projective charts");
for (int i=1; i<=6; i++) {
  C=J,var(i)-1;
  B=std(C);
  E=eliminate(B,x1*x2*x3*x4*x5*x6);
  print("chart index, dimension, elimination ideal:");
  i;
  dim(B);
  E;
  if (dim(B) != 1) {
    ERROR("Unexpected dimension in a hyperplane-section chart.");
  }
  if (size(E) != 1) {
    ERROR("The elimination ideal does not have one generator.");
  }
  if (E[1] != 8*t^2+5*t+5) {
    ERROR("The elimination ideal is not the expected quadratic ideal.");
  }
}
print("PASS: f is smooth and all six charts have the expected elimination ideal.");
exit;
