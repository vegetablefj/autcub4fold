# These are the connected symplectic-family rows in the rank-at-least-15
# lattice table.  Their recorded full groups are generic on their families,
# so they are retained as comparison targets but need no saturation test.
LargeKoikeFamilySourceRecord.symplecticFamilyCount :=
  Number(LargeKoikeFamilies, record -> record.isSymplecticFamily);
LargeKoikeFamilySourceRecord.properFamilyCount :=
  Length(LargeKoikeFamilies) - LargeKoikeFamilySourceRecord.symplecticFamilyCount;

# Apply only the seven coordinate changes certified by the final audit.
for LargeKoikeRecord in LargeKoikeFamilies do
  LargeKoikeRecord.isHighRankVerificationExempt :=
    LargeKoikeRecord.rankS >= 19;
  LargeKoikeRecord.isSevenDivisibleVerificationExempt :=
    LargeKoikeRecord.projectiveGroupId[1] mod 7 = 0;
  LargeKoikeRecord.isTheoryVerificationExempt :=
    LargeKoikeRecord.isHighRankVerificationExempt
    or LargeKoikeRecord.isSevenDivisibleVerificationExempt;
  LargeKoikeRecord.requiresSmoothnessCheck :=
    not LargeKoikeRecord.isSymplecticFamily
    and not LargeKoikeRecord.isTheoryVerificationExempt;
  LargeKoikeRecord.requiresSelfConjugacyCheck :=
    LargeKoikeRecord.requiresSmoothnessCheck
    and LargeKoikeRecord.genericIndex = 2;
  LargeKoikeRecord.requiresSaturationCheck :=
    LargeKoikeRecord.requiresSmoothnessCheck
    and not LargeKoikeRecord.isKnownSaturatedFamily;

  if LargeKoikeRecord.isSymplecticFamily then
    LargeKoikeRecord.smoothnessExemptionReason :=
      "connected symplectic family";
    LargeKoikeRecord.selfConjugacyExemptionReason :=
      "connected symplectic family";
    LargeKoikeRecord.saturationExemptionReason :=
      "connected symplectic family";
  elif LargeKoikeRecord.isHighRankVerificationExempt
       and LargeKoikeRecord.isSevenDivisibleVerificationExempt then
    LargeKoikeRecord.smoothnessExemptionReason :=
      "rank(S) at least 19 and projective group order divisible by 7";
    LargeKoikeRecord.selfConjugacyExemptionReason :=
      LargeKoikeRecord.smoothnessExemptionReason;
    LargeKoikeRecord.saturationExemptionReason :=
      LargeKoikeRecord.smoothnessExemptionReason;
  elif LargeKoikeRecord.isHighRankVerificationExempt then
    LargeKoikeRecord.smoothnessExemptionReason :=
      "rank(S) at least 19";
    LargeKoikeRecord.selfConjugacyExemptionReason :=
      LargeKoikeRecord.smoothnessExemptionReason;
    LargeKoikeRecord.saturationExemptionReason :=
      LargeKoikeRecord.smoothnessExemptionReason;
  elif LargeKoikeRecord.isSevenDivisibleVerificationExempt then
    LargeKoikeRecord.smoothnessExemptionReason :=
      "projective group order divisible by 7";
    LargeKoikeRecord.selfConjugacyExemptionReason :=
      LargeKoikeRecord.smoothnessExemptionReason;
    LargeKoikeRecord.saturationExemptionReason :=
      LargeKoikeRecord.smoothnessExemptionReason;
  else
    LargeKoikeRecord.smoothnessExemptionReason := fail;
    LargeKoikeRecord.saturationExemptionReason := fail;
    if LargeKoikeRecord.genericIndex <> 2 then
      LargeKoikeRecord.selfConjugacyExemptionReason :=
        "row index is not 2";
    else
      LargeKoikeRecord.selfConjugacyExemptionReason := fail;
    fi;
  fi;
  if LargeKoikeRecord.isKnownSaturatedFamily then
    if LargeKoikeRecord.symplecticPart = "QD_16"
       and LargeKoikeRecord.genericIndex = 2 then
      LargeKoikeRecord.saturationExemptionReason :=
        "known saturated index-2 QD16 family";
    else
      LargeKoikeRecord.saturationExemptionReason :=
        "known saturated 3^{1+4}:2 family";
    fi;
  fi;
  LargeKoikeRecord.matrixGenerators := List(
    LargeKoikeRecord.matrixGeneratorsRaw,
    A -> LargeKoikeRecord.coordinateChange^-1 * A * LargeKoikeRecord.coordinateChange );
od;

LargeKoikeSmoothnessCheckFamilies := Filtered(
  LargeKoikeFamilies,
  record -> record.requiresSmoothnessCheck );
LargeKoikeHighRankVerificationExemptFamilies := Filtered(
  LargeKoikeFamilies,
  record -> record.isHighRankVerificationExempt );
LargeKoikeSevenDivisibleVerificationExemptFamilies := Filtered(
  LargeKoikeFamilies,
  record -> record.isSevenDivisibleVerificationExempt );
LargeKoikeSelfConjugacyCheckFamilies := Filtered(
  LargeKoikeFamilies,
  record -> record.requiresSelfConjugacyCheck );
LargeKoikeSaturationCheckFamilies := Filtered(
  LargeKoikeFamilies,
  record -> record.requiresSaturationCheck );
LargeKoikeTheoryExemptProperFamilies := Filtered(
  LargeKoikeFamilies,
  record -> not record.isSymplecticFamily
            and record.isTheoryVerificationExempt );
LargeKoikeKnownSaturatedProperFamilies := Filtered(
  LargeKoikeFamilies,
  record -> not record.isSymplecticFamily
            and record.isKnownSaturatedFamily );

LargeKoikeFamilySourceRecord.theoryExemptProperCount :=
  Length(LargeKoikeTheoryExemptProperFamilies);
LargeKoikeFamilySourceRecord.knownSaturatedProperCount :=
  Length(LargeKoikeKnownSaturatedProperFamilies);
LargeKoikeFamilySourceRecord.highRankVerificationExemptCount :=
  Length(LargeKoikeHighRankVerificationExemptFamilies);
LargeKoikeFamilySourceRecord.sevenDivisibleVerificationExemptCount :=
  Length(LargeKoikeSevenDivisibleVerificationExemptFamilies);
LargeKoikeFamilySourceRecord.smoothnessCheckCount :=
  Length(LargeKoikeSmoothnessCheckFamilies);
LargeKoikeFamilySourceRecord.selfConjugacyCheckCount :=
  Length(LargeKoikeSelfConjugacyCheckFamilies);
LargeKoikeFamilySourceRecord.saturationCheckCount :=
  Length(LargeKoikeSaturationCheckFamilies);
Unbind(LargeKoikeRecord);
